%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Times New Roman, Times, serif", "fontSize": "15px", "primaryColor": "#ffffff", "primaryTextColor": "#111111", "primaryBorderColor": "#222222", "lineColor": "#222222", "secondaryColor": "#f7f7f7", "tertiaryColor": "#ffffff", "clusterBkg": "#fbfbfb", "clusterBorder": "#777777"}}}%%
flowchart LR
  subgraph api["Workload APIs"]
    direction TB
    pod["Kubernetes Pod"]
    batch["AIBrix BatchJob"]
    serve["AIBrix Serving"]
  end

  intent["Resource Intent<br/>GPU, budget, SLO, recovery"]

  subgraph manager["Shared GPU Resource Manager"]
    direction LR
    filter["Capability<br/>Filter"]
    rank["Placement Planner<br/>price, risk, fallback"]
    plan["Acquire Plan<br/>selected + backups"]
    acquire["Acquire Orchestrator<br/>idempotency, retry"]
  end

  subgraph signals["Market and Policy Signals"]
    direction TB
    catalog["Offer Catalog<br/>native APIs + observations"]
    price["Price / Burn-rate<br/>estimate + provider billing"]
    policy["Policy<br/>budget, spot, deadline"]
    failures["Failure Signals<br/>attempts, cooldown, scorecard"]
  end

  adapters["Provider Adapters"]

  subgraph cloud["Cloud GPU Providers"]
    direction TB
    runpod["RunPod Pods"]
    lambda["Lambda VMs"]
    other["Vast / Cloud VMs"]
  end

  subgraph state["Durable State and Surfaces"]
    direction TB
    store["Binding / JobStore"]
    attempts["Attempts + Conditions"]
    metrics["Cost + Events + Metrics"]
  end

  pod --> intent
  batch --> intent
  serve --> intent

  intent --> filter --> rank --> plan --> acquire --> adapters
  adapters --> runpod
  adapters --> lambda
  adapters --> other

  catalog --> filter
  price --> rank
  policy --> rank
  failures --> rank

  acquire --> store
  acquire --> attempts
  acquire --> metrics

  runpod --> observe["Observation Loop<br/>get, list, callback, billing"]
  lambda --> observe
  other --> observe
  observe -.-> catalog
  observe -.-> price
  observe -.-> failures
  observe -.-> store

  classDef apiNode fill:#ffffff,stroke:#222222,stroke-width:1.2px,color:#111111
  classDef coreNode fill:#eef3fb,stroke:#1f4e79,stroke-width:1.4px,color:#111111
  classDef signalNode fill:#f4f4f4,stroke:#333333,stroke-width:1.1px,color:#111111
  classDef execNode fill:#f8f0e6,stroke:#7a4a12,stroke-width:1.2px,color:#111111
  classDef providerNode fill:#ffffff,stroke:#222222,stroke-width:1.2px,color:#111111
  classDef stateNode fill:#f4f4f4,stroke:#333333,stroke-width:1.1px,color:#111111

  class pod,batch,serve apiNode
  class intent,filter,rank,plan coreNode
  class catalog,price,policy,failures,observe signalNode
  class acquire,adapters execNode
  class runpod,lambda,other providerNode
  class store,attempts,metrics stateNode
