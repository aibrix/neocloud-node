flowchart LR
  subgraph callers["Product callers"]
    pod["Kubernetes Pod<br/>GPU Burst Node / VK"]
    batch["AIBrix BatchJob"]
    serving["AIBrix Online Serving"]
  end

  pod --> pod_tf["Pod Transformer"]
  batch --> batch_tf["Batch Intent Builder"]
  serving --> serving_tf["Serving Intent Builder"]
  pod_tf --> intent["ResourceIntent<br/>GPU shape / SLO / budget / recovery"]
  batch_tf --> intent
  serving_tf --> intent

  subgraph shared["Shared GPU Resource Manager"]
    catalog["OfferCatalog<br/>bootstrap / native catalog / observations"]
    price["PriceEstimator<br/>catalog quote / provider billing / burn rate"]
    signals["FailureSignals<br/>attempts / cooldown / scorecard"]
    policy["PlacementPolicy<br/>provider order / spot / fallback / deadline"]
    planner["PlacementPlanner<br/>filter / risk adjusted rank / explain"]
    plan["AcquirePlan<br/>selected offer + fallback candidates"]
    lifecycle["AcquireOrchestrator<br/>idempotent create / error classify / fallback"]
  end

  intent --> planner
  catalog --> planner
  price --> planner
  signals --> policy
  policy --> planner
  planner --> plan
  plan --> lifecycle

  lifecycle --> adapters["ProviderAdapters<br/>RunPod / Lambda / Vast / Cloud VM"]
  adapters --> remote["Provider resources<br/>Pod / VM / endpoint"]
  remote --> observe["Observe<br/>get / list / callback / billing"]
  observe --> catalog
  observe --> price

  subgraph persistence["Caller-owned persistence and surfaces"]
    binding["CloudPodBinding<br/>remoteID / cost / attempts / conditions"]
    jobstore["AIBrix JobStore<br/>lineage / retries / cost"]
    metrics["Metrics and Events<br/>burn rate / reasons / cleanup"]
  end

  lifecycle --> binding
  lifecycle --> jobstore
  lifecycle --> metrics
  binding --> signals
  jobstore --> signals
